APP_NAME=AutoVAD
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local default (recommended for quick start):
DATABASE_URL=sqlite:///./autovad.db
# Optional Postgres for staging/prod-like runs:
# DATABASE_URL=postgresql://autovad:autovad@localhost:5432/autovad
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv,png,jpg,jpeg,tif,tiff,zip,dxf,dwg,xml,landxml,json
# 0 = unlimited document / bid template upload size (set e.g. 200 to enforce an MB cap)
MAX_UPLOAD_SIZE_MB=0
CAD_ENGINE_ENABLED=true
CAD_OPENAI_ENRICHMENT=true
# CadModel entity JSON caps for persistence (0 = keep all parsed rows)
CAD_STORE_LINES_LIMIT=5000
CAD_STORE_POLYLINES_LIMIT=5000
CAD_STORE_CIRCLES_LIMIT=2000
CAD_STORE_HATCHES_LIMIT=2000
AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=
AUTODESK_BUCKET_KEY=
AUTODESK_POLL_TIMEOUT_SECONDS=3600
AUTODESK_POLL_INTERVAL_SECONDS=5
# Design Automation (cloud AutoCAD) — enable Design Automation API on your APS app
DESIGN_AUTOMATION_ENABLED=true
DESIGN_AUTOMATION_NICKNAME=
DESIGN_AUTOMATION_ENGINE=auto
DESIGN_AUTOMATION_TIMEOUT_SECONDS=3600
DESIGN_AUTOMATION_PREFER_PLUGIN=true
DESIGN_AUTOMATION_FALLBACK_MODEL_DERIVATIVE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# PDF drawing vision takeoff
# SCAN_ALL=true and MAX_PAGES=0 = every page, including 1000-page / 1GB plan sets.
# Completeness over speed: Analyze may run 60+ minutes. BATCH_PAGES is RAM chunking only.
# VISION_MAX_SECONDS=0 means no wall-clock stop. Per-call timeout skips one stuck batch only.
OPENAI_PDF_VISION_ENABLED=true
OPENAI_VISION_SCAN_ALL_PAGES=true
OPENAI_VISION_BATCH_PAGES=8
OPENAI_VISION_MAX_PAGES=0
OPENAI_VISION_DPI=150
OPENAI_VISION_MIN_SCORE=18
OPENAI_VISION_FORCE_UTILITY_PAGES=true
OPENAI_REQUEST_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=1
OPENAI_VISION_MAX_SECONDS=0
OPENAI_VISION_LARGE_PAGE_THRESHOLD=80
OPENAI_VISION_LARGE_FILE_MB=80
OPENAI_VISION_LARGE_MAX_PAGES=0
OPENAI_VISION_LARGE_BATCH_PAGES=2
OPENAI_VISION_LARGE_DPI=150
OPENAI_VISION_LARGE_MAX_SECONDS=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
