APP_NAME=AutoVAD
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql://autovad:autovad@localhost:5432/autovad
# Optional local fallback if Postgres is unavailable:
# DATABASE_URL=sqlite:///./autovad.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv,png,jpg,jpeg,tif,tiff,zip,dxf,dwg,xml,landxml,json
# 0 = unlimited document / bid template upload size (set e.g. 200 to enforce an MB cap)
MAX_UPLOAD_SIZE_MB=0
CAD_ENGINE_ENABLED=true
CAD_OPENAI_ENRICHMENT=true
AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=
AUTODESK_BUCKET_KEY=
AUTODESK_POLL_TIMEOUT_SECONDS=3600
AUTODESK_POLL_INTERVAL_SECONDS=5
# Design Automation (cloud AutoCAD) — enable Design Automation API on your APS app
DESIGN_AUTOMATION_ENABLED=true
DESIGN_AUTOMATION_NICKNAME=
DESIGN_AUTOMATION_ENGINE=auto
DESIGN_AUTOMATION_TIMEOUT_SECONDS=3600
DESIGN_AUTOMATION_PREFER_PLUGIN=true
DESIGN_AUTOMATION_FALLBACK_MODEL_DERIVATIVE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# PDF drawing vision takeoff
# SCAN_ALL=true means every uploaded PDF page is checked (not an upload size limit).
# BATCH_PAGES = pages per OpenAI call (chunking only). MAX_PAGES=0 means no page ceiling.
OPENAI_PDF_VISION_ENABLED=true
OPENAI_VISION_SCAN_ALL_PAGES=true
OPENAI_VISION_BATCH_PAGES=8
OPENAI_VISION_MAX_PAGES=0
OPENAI_VISION_DPI=150
OPENAI_VISION_MIN_SCORE=18
OPENAI_VISION_FORCE_UTILITY_PAGES=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
