aws_region   = "us-east-1"
project_name = "autovad"
environment  = "prod"

# Leave empty for CloudFront default HTTPS domain.
# For custom domain, set all three:
domain_name            = ""
create_acm_certificate = false
route53_zone_id        = ""

# Security: put YOUR public IP/CIDR here for SSH/bastion (never 0.0.0.0/0 in prod)
admin_cidr_blocks = []
enable_bastion    = false
bastion_key_name  = ""

app_instance_type = "t3.medium"
db_instance_class = "db.t3.medium"
db_multi_az       = true
db_deletion_protection = true

enable_waf            = true
enable_vpc_flow_logs  = true

# Optional monitoring / email
alarm_email   = ""
ses_from_email = ""
